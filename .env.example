# Copy to .env.local and fill in your own values. Never commit the real file.

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/vaultcloud

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# AWS S3 (bucket region: ap-south-1)
AWS_ACCESS_KEY=
AWS_SECRET=
AWS_BUCKET_NAME=

# Email for password-reset and invite mails (Gmail needs an App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# Firebase (Firestore, used for room chat)
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_STORAGE_BUCKET=
NEXT_PUBLIC_MESSAGING_SENDER_ID=
NEXT_PUBLIC_APP_ID=
